#!/usr/bin/env bash
# ============================================================
# mki — un comando para todo (Etapa 5.0 WS6). Uso: ./mki <subcomando>
#
#   arrancar   API (:8000) + frontend Vite (:5173)
#   estado     jobs del planificador, último sello, salud, presupuesto IA
#   reporte    envía el reporte de Telegram AHORA (compuesto del sello)
#   tests      suite completa: pytest + anti-look-ahead del motor
#   auditoria  revisión de SOLO LECTURA del sistema completo
#   instalar   jobs automáticos (6) + hook pre-commit
#
# PORTABILIDAD (Etapa 5.0.3): este script corre en macOS (el titular) y en
# Linux/WSL2 (la máquina sombra). Ramifica por `uname -s`, no por reemplazo:
# el Mac sigue en producción y ejecuta exactamente este mismo archivo.
#  · macOS → launchd  (launchctl · launchd/instalar.sh)
#  · Linux → systemd  (systemctl --user · systemd/instalar.sh)
# ============================================================
set -u
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR"

# Node del Mac vive en ~/.local/node (sin brew/sudo); en Linux viene del
# sistema. Se antepone solo si existe, para no ensuciar el PATH ajeno.
[ -d "$HOME/.local/node/bin" ] && export PATH="$HOME/.local/node/bin:$PATH"

case "$(uname -s)" in
  Darwin) MKI_SO="mac"   ;;
  Linux)  MKI_SO="linux" ;;
  *)      MKI_SO="desconocido" ;;
esac

case "${1:-ayuda}" in
  arrancar)
    echo "API en :8000 y frontend en :5173 — Ctrl+C corta ambos."
    source venv/bin/activate
    uvicorn api.main:app --port 8000 &
    API_PID=$!
    trap "kill $API_PID 2>/dev/null" EXIT
    cd frontend && npm run dev
    ;;
  estado)
    case "$MKI_SO" in
      mac)
        echo "== Jobs launchd =="
        launchctl list | grep com.mki || echo "  (ninguno instalado — ./mki instalar)"
        ;;
      linux)
        echo "== Jobs systemd (--user) =="
        # Se distingue "no hay timers" de "systemd no responde": decir
        # "ninguno instalado" cuando en realidad no se puede preguntar
        # sería una falsa tranquilidad justo en el chequeo de salud.
        if ! command -v systemctl >/dev/null 2>&1; then
          echo "  NO SE PUDO PREGUNTAR: no hay systemctl en esta máquina."
        elif [ "$(ps -p 1 -o comm= 2>/dev/null)" != "systemd" ]; then
          echo "  NO SE PUDO PREGUNTAR: PID 1 no es systemd" \
               "(es '$(ps -p 1 -o comm= 2>/dev/null)')."
          echo "   Remedio: /etc/wsl.conf → [boot] systemd=true, y luego"
          echo "   'wsl --shutdown' desde Windows para reiniciar la VM."
        else
          TABLA="$(systemctl --user list-timers 'mki-*' --all --no-pager 2>&1)"
          if printf '%s' "$TABLA" | grep -q 'mki-'; then
            printf '%s\n' "$TABLA"
          elif printf '%s' "$TABLA" | grep -qi 'failed to connect'; then
            echo "  NO SE PUDO PREGUNTAR: el bus de usuario de systemd no responde."
            echo "   $TABLA"
          else
            echo "  (ninguno instalado — ./mki instalar)"
          fi
        fi
        ;;
      *)
        echo "== Jobs =="
        echo "  (SO no reconocido: $(uname -s) — sin planificador conocido)"
        ;;
    esac
    echo ""
    echo "== Último sello y salud =="
    source venv/bin/activate
    python - <<'PY'
import senales, costos
info = senales.info_snapshot_hoy()
if info:
    d = (f" · descarga {info['descarga_ok']}/{info['descarga_total']}"
         if info.get("descarga_ok") is not None else "")
    print(f"  snapshot HOY: sellado {info['timestamp_utc']} ({info['origen']}){d}")
else:
    hist = senales.historial_snapshots(1)
    ultimo = hist.iloc[0]["Fecha"] if not hist.empty else "nunca"
    print(f"  snapshot HOY: no hay (último: {ultimo})")
p = costos.estado_presupuesto()
print(f"  IA hoy: {p['gasto_usd']:.4f}/{p['tope_usd']:.2f} USD"
      + (" — FRENO" if p["agotado"] else ""))
est = dict(senales.conteo_por_estado().itertuples(index=False, name=None))
print(f"  predicciones: {est}")
PY
    echo ""
    echo "== Últimas líneas del vigía =="
    tail -6 data/vigia.log 2>/dev/null || echo "  (sin log del vigía aún)"
    ;;
  reporte)
    source venv/bin/activate && python alertas.py reporte
    ;;
  tests)
    source venv/bin/activate
    python -m pytest tests/ -q && python tests/test_motor.py
    ;;
  auditoria)
    echo "== Auditoría de solo lectura =="
    source venv/bin/activate
    python - <<'PY'
from datetime import date
import senales, costos, mki_vigia
print(f"fecha: {date.today().isoformat()}")
for chequeo in (mki_vigia.chequear_snapshot, mki_vigia.chequear_descarga,
                mki_vigia.chequear_noticias, mki_vigia.chequear_reporte,
                mki_vigia.chequear_backup):
    ok, detalle = chequeo()
    print(f"  {'OK   ' if ok else 'FALLA'} {detalle}")
print("\nsellos de la última semana (fecha, origen, régimen, descarga):")
conn = senales.get_connection()
for f in conn.execute("""SELECT fecha, origen, regimen,
        COALESCE(descarga_ok || '/' || descarga_total, 'pre-5.0')
        FROM snapshots ORDER BY fecha DESC LIMIT 7"""):
    print(f"  {f}")
conn.close()
print(f"\ngasto IA del mes: {costos.gasto_del_mes():.2f} USD")
PY
    echo ""
    echo "== git =="
    git status --short | head -10
    git log --oneline -3
    ;;
  instalar)
    case "$MKI_SO" in
      mac)
        bash launchd/instalar.sh
        ;;
      linux)
        # El Mac es el titular. Instalar los timers aquí convierte a esta
        # máquina en un SEGUNDO titular esa misma noche: manda su propio
        # reporte de Telegram, commitea backups y sella en paralelo. El
        # modo sombra (Fase 3) es lo que lo evita. Por eso, y solo en
        # Linux, la instalación de timers se confirma.
        echo "AVISO: vas a instalar los 6 timers de systemd en esta máquina."
        echo "  Si el Mac sigue siendo titular y aquí NO está activo el modo"
        echo "  sombra (MKI_MODO=sombra), esta máquina duplicará el reporte de"
        echo "  Telegram y commiteará backups en paralelo desde la próxima noche."
        if [ -t 0 ]; then
          printf "  ¿Instalar los timers igualmente? [escribe: si] "
          read -r RESPUESTA
        else
          RESPUESTA="${MKI_INSTALAR_TIMERS:-no}"
        fi
        if [ "$RESPUESTA" = "si" ]; then
          bash systemd/instalar.sh
        else
          echo "  timers NO instalados (solo se instala el hook pre-commit)."
        fi
        ;;
      *)
        echo "SO no reconocido ($(uname -s)): no hay instalador de jobs."
        echo "  Se instala solo el hook pre-commit."
        ;;
    esac
    cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
    echo "hook pre-commit instalado (.git/hooks/pre-commit)"
    ;;
  *)
    grep '^#   ' "$0" | sed 's/^#   /  /'
    ;;
esac
