[Unit]
Description=MKI — sella el snapshot diario (señales, régimen, predicciones, salud de descarga) (timer)

[Timer]
# Hábiles, hora de Chile declarada explícitamente: el timer no depende de
# que la zona del sistema sea la correcta.
OnCalendar=Mon..Fri 18:15 America/Santiago

# Si la VM estaba abajo a la hora del disparo, se ejecuta al volver.
# Validado el 14-ago: tras el wsl --shutdown de Docker Desktop, los 6
# timers de MKI conservaron su LAST mientras los de Ubuntu la perdieron.
Persistent=true
AccuracySec=1s

Unit=mki-snapshot.service

[Install]
WantedBy=timers.target
