[Unit]
Description=MKI — sella el snapshot diario (señales, régimen, predicciones, salud de descarga)
Documentation=file://__MKI_DIR__/systemd/INSTALACION.md

[Service]
Type=oneshot
WorkingDirectory=__MKI_DIR__
ExecStart=__MKI_DIR__/venv/bin/python __MKI_DIR__/snapshot.py --origen programado

# El job termina SIEMPRE. La herida del 03-ago (feedparser sin timeout dejó
# un proceso vivo 4 días y launchd nunca re-disparó el label) se cierra en
# dos capas: socket.setdefaulttimeout(30) en el entrypoint, y este techo.
TimeoutStartSec=1200
KillMode=mixed

# El log va al MISMO archivo que en macOS: registro.rotar_log hace
# copy-truncate sobre él y ./mki estado y el vigía lo leen.
StandardOutput=append:__MKI_DIR__/data/snapshot.log
StandardError=append:__MKI_DIR__/data/snapshot.log

Environment=PYTHONUNBUFFERED=1
Environment=TZ=America/Santiago
