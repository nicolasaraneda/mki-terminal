#!/usr/bin/env bash
# ============================================================
# Hook pre-commit de MKI Terminal (Etapa 5.0 WS6).
# Se instala con `./mki instalar` (copia a .git/hooks/pre-commit).
#
# 1. SIEMPRE: escanea lo stageado por patrones de secretos reales
#    (clave Anthropic completa, token de bot de Telegram). Los ejemplos
#    de documentación y los secretos FALSOS de tests/test_seguridad.py
#    no disparan (patrones exigen largo real; ese test se excluye).
# 2. Rechaza el commit dentro de la VENTANA DE SELLADO (17:50-20:30 de
#    Chile, dia habil), porque la suite toca la red — scripts/guarda_red.sh.
#    Con MKI_EN_VENTANA=1 corre la suite sin los tests marcados
#    `red` y lo anuncia como verificacion PARCIAL.
# 3. Corre la suite de tests, SALVO que:
#    - el commit sea SOLO de data/backups (el job diario de backup no
#      puede quedar bloqueado por un test que falla por otra razón), o
#    - se fuerce con SKIP_TESTS=1 (documentado en README-DEV.md).
#
# PORTABILIDAD (Etapa 5.0.3): bash, no zsh. Este archivo se copia tal cual
# a .git/hooks/pre-commit en las dos máquinas (macOS titular y Linux/WSL2);
# no tiene nada específico de plataforma, así que no ramifica por uname.
# ============================================================
set -u
RAIZ="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"
[ -z "$STAGED" ] && exit 0

# --- 1) secretos en lo stageado (excluye los secretos FALSOS del test) ---
if git diff --cached -- . ':(exclude)tests/test_seguridad.py' \
    | grep -qE 'sk-ant-api[0-9]{2}-[A-Za-z0-9_-]{30,}|[0-9]{8,12}:AA[A-Za-z0-9_-]{20,}'; then
  echo "pre-commit BLOQUEADO: hay un patrón de secreto real en lo stageado."
  echo "Revisa con: git diff --cached | grep -nE 'sk-ant-|:AA'"
  exit 1
fi

# --- 2) tests (con las excepciones de arriba) ---
if [ "${SKIP_TESTS:-0}" = "1" ]; then
  echo "pre-commit: tests saltados por SKIP_TESTS=1"
  exit 0
fi
if ! echo "$STAGED" | grep -qvE '^data/backups/'; then
  exit 0  # solo respaldos: el escaneo de secretos basta
fi

cd "$RAIZ"
source venv/bin/activate 2>/dev/null || true

# --- 3) la ventana de sellado (17:50-20:30 de Chile, día hábil) ---
# La suite TOCA LA RED: motor._datos_crudos llama a yf.download con caché
# sólo en memoria. Correrla mientras el sistema sella es competir con el
# snapshot por la misma fuente. El 3-sep-2026 este hook la corrió a las
# 17:57; el sello salió sano y la regla se cruzó igual.
#
# Dentro de la ventana el commit se RECHAZA, no se deja pasar con una suite
# recortada haciéndose pasar por verde: un verde antes del sello no es un
# verde. Quien necesite commitear igual lo declara con MKI_EN_VENTANA=1,
# y entonces sí se corre la suite sin los tests marcados `red` — pero
# anunciada como verificación PARCIAL, que es lo que es.
SUITE=(python -m pytest tests/ -q)
if bash "$RAIZ/scripts/guarda_red.sh"; then
  echo "pre-commit: REGLA DE LA VENTANA DE SELLADO."
  echo "  Entre 17:50 y 20:30 de Chile, en dia habil, el sistema sella"
  echo "  (noticias 17:50 - snapshot 18:15 - reporte 18:25 - backup 18:40 -"
  echo "  vigia 19:00 - re-chequeo 20:30) y no corre nada que descargue."
  echo "  La suite descarga: motor._datos_crudos -> yf.download."
  if [ "${MKI_EN_VENTANA:-0}" != "1" ]; then
    echo "pre-commit BLOQUEADO: espera a las 20:30, o declaralo con"
    echo "  MKI_EN_VENTANA=1 git commit ...  (corre la suite SIN los"
    echo "  tests marcados 'red': verificacion PARCIAL, no un verde)."
    exit 1
  fi
  echo "  MKI_EN_VENTANA=1: se corre la suite SIN los tests 'red'."
  echo "  AVISO: VERIFICACION PARCIAL. Los tests que tocan la red NO se"
  echo "  corrieron; esto no equivale a la suite completa en verde."
  SUITE=(python -m pytest tests/ -q -m "not red")
fi

# --- 4) tests ---
if ! "${SUITE[@]}"; then
  echo "pre-commit BLOQUEADO: la suite de tests falló."
  echo "(Para un commit de emergencia consciente: SKIP_TESTS=1 git commit ...)"
  exit 1
fi
exit 0
