# ============================================================
# MKI Terminal — configuración local
#
# Copia este archivo a ".env" (sin el ".example") y completa tus
# valores reales. El ".env" real está en .gitignore y JAMÁS debe
# commitearse; este ejemplo no contiene ningún secreto.
# ============================================================

# --- Claude / Anthropic (análisis de noticias con IA) ---
# Consigue tu clave en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-tu-clave-aqui

# --- Telegram (reporte diario y alertas) ---
# Cómo crear el bot y obtener estos valores: `python alertas.py --help`
# o el panel de Telegram en la portada Hoy del dashboard.
TELEGRAM_BOT_TOKEN=1234567890:AAF-abc123def456...
TELEGRAM_CHAT_ID=123456789

# --- Guardarraíl de presupuesto (Etapa 5.0) ---
# Tope de gasto diario en la API de Anthropic para el análisis de
# noticias, en dólares. Al alcanzarlo, el análisis se detiene y llega
# un aviso por Telegram. Si no se define, el tope es 0.50 USD/día.
NOTICIAS_PRESUPUESTO_USD_DIA=0.50
