# --- Entorno y secretos (JAMÁS se versionan) ---
.env*
!.env.example

# --- Python ---
venv/
__pycache__/
*.pyc
.pytest_cache/

# --- Bases de datos locales (el respaldo versionado son los CSV de data/backups/) ---
*.db
*.db-journal
noticias.db
senales.db
alertas.db

# --- Logs (pueden contener detalles de errores; nunca al repo) ---
*.log
data/*.log

# --- Estado de runtime (marcador de alerta pendiente del vigía, 5.0.1) ---
data/vigia_pendiente.json

# --- Node / frontend (frontend/.gitignore cubre lo suyo; esto es red de seguridad) ---
node_modules/
dist/

# --- Caché de investigación de GEMELO (megas de CSV, regenerable) ---
GEMELO/cache/

# --- Binarios compilados del arnés de latencia (micro/) — nunca al repo,
# se reconstruyen con `make`; un binario en git es irreversible en la
# historia. Los JSON de micro/resultados/ SÍ se versionan a propósito (son
# la evidencia medida, chicos, texto plano — mismo criterio que
# backtest/resultados/). ---
micro/bin/

# --- Sistema y herramientas ---
.DS_Store
.claude/settings.local.json
.claude.respaldo-*
