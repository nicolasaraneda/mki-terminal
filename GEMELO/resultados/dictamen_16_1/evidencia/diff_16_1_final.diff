+    manda la última corrida: sin negativa, es falla."""
+    codigo = snapshot.NEGATIVA_FRESCURA
+    _escribir_log(_cabecera(HOY)
+                  + _linea_negativa(codigo, HOY, AYER, "fuente atrasada")
+                  + _cabecera(HOY, "22:40:00")
