+    _sembrar_puntaje(VIEJA, "MU", f"{VIEJA}T21:15:00+00:00", None)
+    _sembrar_puntaje(VIEJA, "TSM", f"{VIEJA}T21:15:00+00:00", f"{VIEJA}T21:15:00+00:00")
