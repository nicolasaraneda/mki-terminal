+TS = f"{HOY.isoformat()}T21:15:00+00:00"
+AV_ANTES = f"{HOY.isoformat()}T20:00:00+00:00"
+AV_DESPUES = f"{HOY.isoformat()}T23:00:00+00:00"
+
