<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mki.vigia.rechequeo</string>

    <!-- Plantilla (Etapa 5.0.1): __MKI_DIR__ se reemplaza por la ruta real
         del proyecto al instalar — usa launchd/instalar.sh. El epilogo de la
         alerta de las 19:00: si el vigia dejo un marcador pendiente, revisa
         si el snapshot ya sello (retractacion) o sigue caido; sin marcador,
         sale en silencio. Job diario idempotente — sobrevive a que el
         proceso de las 19:00 muera (un sleep interno moriria con el). -->
    <key>ProgramArguments</key>
    <array>
        <string>__MKI_DIR__/venv/bin/python</string>
        <string>__MKI_DIR__/mki_vigia.py</string>
        <string>--rechequeo</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__MKI_DIR__</string>

    <!-- Lunes a viernes a las 20:30 hora local del sistema (Chile).
         Weekday: 1=lunes ... 5=viernes. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>20</integer><key>Minute</key><integer>30</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>__MKI_DIR__/data/vigia.log</string>
    <key>StandardErrorPath</key>
    <string>__MKI_DIR__/data/vigia.log</string>
</dict>
</plist>
